#include <iostream>
using namespace std;

int main()
{
    int stack[100], top = -1;
    int choice, value;

    do
    {
        cout << "\n\nSTACK MENU";
        cout << "\n1. Push";
        cout << "\n2. Pop";
        cout << "\n3. Peek";
        cout << "\n4. Display";
        cout << "\n5. Exit";
        cout << "\nEnter your choice: ";
        cin >> choice;

        switch (choice)
        {
            case 1:
                if (top == 99)
                {
                    cout << "Stack Overflow!";
                }
                else
                {
                    cout << "Enter value: ";
                    cin >> value;

                    top++;
                    stack[top] = value;

                    cout << value << " pushed into stack.";
                }
                break;

            case 2:
                if (top == -1)
                {
                    cout << "Stack Underflow!";
                }
                else
                {
                    cout << "Deleted element: " << stack[top];
                    top--;
                }
                break;

            case 3:
                if (top == -1)
                {
                    cout << "Stack is empty!";
                }
                else
                {
                    cout << "Top element: " << stack[top];
                }
                break;

            case 4:
                if (top == -1)
                {
                    cout << "Stack is empty!";
                }
                else
                {
                    cout << "Stack elements are: ";

                    for (int i = top; i >= 0; i--)
                    {
                        cout << stack[i] << " ";
                    }
                }
                break;

            case 5:
                cout << "Program exited successfully.";
                break;

            default:
                cout << "Invalid choice!";
        }

    } while (choice != 5);

    return 0;
}
